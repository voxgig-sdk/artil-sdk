            version: 2
          }
          g: {
            params: [
              {
                k: "param"
                n: "agent_id"
                or: "id"
                r: true
                t: "`$STRING`"
              }
              {
                k: "param"
                n: "id"
                or: "addressId"
                r: true
                t: "`$STRING`"
              }
            ]
          }
          m: "GET"
          o: "/agents/{id}/addresses/{addressId}"
          q: {
            exist: [
              "agent_id"
              "id"
            ]
          }
          r: {
            param: {
              addressId: "id"
              id: "agent_id"
            }
          }
          rs: {
            kind: "json"
