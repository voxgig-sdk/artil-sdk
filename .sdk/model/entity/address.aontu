              }
              {
                k: "param"
                n: "id"
                or: "addressId"
                r: true
                t: "`$STRING`"
              }
            ]
          }
          m: "DELETE"
          o: "/agents/{id}/addresses/{addressId}"
          q: {
            exist: [
