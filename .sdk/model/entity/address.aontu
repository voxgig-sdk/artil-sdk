# Entity: address

main: kit: entity: address: {

  alias: field: {}

  fields: {
    channel: {
      h: "Channel"
      n: "channel"
      r: true
      t: "`$STRING`"
    }
    code: {
      h: "Code"
      n: "code"
      r: false
      sh: "The code the provider's consent page sent the member back with, beside setup"
      t: "`$STRING`"
    }
    country: {
      h: "Country"
      n: "country"
      r: false
      sh: "The ISO country of the phone number; the first one the server sells by default"
      t: "`$STRING`"
    }
    createdAt: {
      fo: "date-time"
      h: "Created At"
      n: "createdAt"
      r: true
      t: "`$STRING`"
    }
    domainId: {
      h: "Domain Id"
      n: "domainId"
      r: true
      sh: "The workspace's own domain the address is on"
      t: "`$ANY`"
    }
    id: {
      fo: "uuid"
      h: "Id"
      n: "id"
      r: true
      t: "`$STRING`"
    }
    name: {
      h: "Name"
      n: "name"
      r: true
      sh: "What people know the address by when its value is an id, like a Slack bot's @name"
      t: [
        "`$ONE`"
        [
          "`$STRING`"
          "`$NULL`"
        ]
      ]
    }
    primary: {
      h: "Primary"
      n: "primary"
      r: true
      sh: "Whether new messages on its channel go out from it"
      t: "`$BOOLEAN`"
    }
    registering: {
      h: "Registering"
      n: "registering"
      r: false
      sh: "Whether US carriers are still registering the phone number, which sends nothing until they have"
      t: "`$BOOLEAN`"
    }
    setup: {
      fo: "uuid"
      h: "Setup"
      n: "setup"
      r: false
      sh: "The state a provider's consent page sent the member back with, for an app they installed from the link setUpAddress gave with token"
      t: "`$STRING`"
    }
    token: {
      h: "Token"
      n: "token"
      r: false
      sh: "What connects an address the workspace already has: the token @BotFather gave a Telegram bot, or a Slack app's bot token and signing secret with a space between"
      t: "`$STRING`"
    }
    value: {
      fo: "email"
      h: "Value"
      n: "value"
      op: {
        create: {
          req: false
          type: "`$STRING`"
        }
      }
      r: true
      sh: "The email address, phone number, Telegram bot's @username, or Slack bot's workspace and member ids"
      t: "`$STRING`"
    }
  }

  id: {
    field: "id"
    name: "id"
  }

  name: "address"
  op: {
    create: {
      name: "create"
      points: [
        {
          co: {
            id: "POST /agents/{id}/addresses/{addressId}/primary"
            source: "openapi3"
            version: 2
          }
          g: {
            params: [
              {
                k: "param"
                n: "agent_id"
                or: "id"
                r: true
                t: "`$STRING`"
              }
              {
                k: "param"
                n: "id"
                or: "addressId"
                r: true
                t: "`$STRING`"
              }
            ]
          }
          m: "POST"
          o: "/agents/{id}/addresses/{addressId}/primary"
          q: {
            "$action": "primary"
            exist: [
              "agent_id"
              "id"
            ]
          }
          r: {
            param: {
              addressId: "id"
              id: "agent_id"
            }
          }
          s: [
            {
              lit: "agents"
            }
            {
              var: "agent_id"
            }
            {
              lit: "addresses"
            }
            {
              var: "id"
            }
            {
              lit: "primary"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
        {
          bf: [
            "channel"
            "code"
            "country"
            "setup"
            "token"
            "value"
          ]
          co: {
            id: "POST /agents/{id}/addresses"
            source: "openapi3"
            version: 2
          }
          g: {
            params: [
              {
                k: "param"
                n: "agent_id"
                or: "id"
                r: true
                t: "`$STRING`"
              }
            ]
          }
          m: "POST"
          o: "/agents/{id}/addresses"
          q: {
            exist: [
              "agent_id"
            ]
          }
          r: {
            param: {
              id: "agent_id"
            }
          }
          rs: {
            kind: "json"
            media: "application/json"
          }
          s: [
            {
              lit: "agents"
            }
            {
              var: "agent_id"
            }
            {
              lit: "addresses"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
