# Entity: message

main: kit: entity: message: {

  alias: field: {}

  fields: {
    addressId: {
      fo: "uuid"
      h: "Address Id"
      n: "addressId"
      r: true
      sh: "The agent's address the message came to or went from; all zeros on url, where the agent's id is its address"
      t: "`$STRING`"
    }
    admission: {
      h: "Admission"
      n: "admission"
      r: true
      sh: "Who the sender of a received message is to the agent: `team` for a member or agent of the workspace, `listed` for a sender on the channel's list, and `anyone` for everyone else, including senders who could not be verified"
      t: "`$ANY`"
    }
    attachments: {
      h: "Attachments"
      n: "attachments"
      op: {
        create: {
          req: false
          type: "`$ARRAY`"
        }
      }
      r: true
      t: "`$ARRAY`"
    }
    author: {
      h: "Author"
      n: "author"
      r: true
      sh: "Who wrote an inbound message in a group, such as a Telegram user id or the email of someone in a Slack channel"
      t: [
        "`$ONE`"
        [
          "`$STRING`"
          "`$NULL`"
        ]
      ]
    }
    authorName: {
      h: "Author Name"
      n: "authorName"
      r: true
      sh: "The name the author goes by, when the channel tells it"
      t: [
        "`$ONE`"
        [
          "`$STRING`"
          "`$NULL`"
        ]
      ]
    }
    cc: {
      h: "Cc"
      n: "cc"
      op: {
        create: {
          req: false
          type: "`$ARRAY`"
        }
      }
      r: true
      sh: "Whom the message names as getting a copy"
      t: "`$ARRAY`"
    }
    channel: {
      h: "Channel"
      n: "channel"
      op: {
        create: {
          req: false
          type: "`$STRING`"
        }
      }
      r: true
      sh: "The channel's kind, from listChannels"
      t: "`$STRING`"
    }
    client: {
      h: "Client"
      n: "client"
      r: false
      sh: "On url, the client you send from, like Codex, which the agent sees beside your name."
      t: "`$STRING`"
    }
    counterpart: {
      h: "Counterpart"
      n: "counterpart"
      r: true
      sh: "Who sent an inbound message, or the group it came in, or the recipients of an outbound one"
      t: "`$STRING`"
    }
    counterpartName: {
      h: "Counterpart Name"
      n: "counterpartName"
      r: true
      sh: "The name an inbound message's sender or group goes by, when the channel tells it"
      t: [
        "`$ONE`"
        [
          "`$STRING`"
          "`$NULL`"
        ]
      ]
    }
    createdAt: {
      fo: "date-time"
      h: "Created At"
      n: "createdAt"
      r: true
      t: "`$STRING`"
    }
    direction: {
      h: "Direction"
      n: "direction"
      r: true
      t: "`$STRING`"
    }
    error: {
      h: "Error"
      n: "error"
      r: true
      sh: "Why a failed message was not sent or did not arrive"
      t: [
        "`$ONE`"
        [
          "`$STRING`"
          "`$NULL`"
        ]
      ]
    }
    forward: {
      fo: "uuid"
      h: "Forward"
      n: "forward"
      r: false
      t: "`$STRING`"
    }
    id: {
      fo: "uuid"
      h: "Id"
      n: "id"
      r: true
      t: "`$STRING`"
    }
    refusal: {
      h: "Refusal"
      n: "refusal"
      r: true
      sh: "Why a refused message did not wake the agent"
      t: "`$ANY`"
    }
    replyTo: {
      fo: "uuid"
      h: "Reply To"
      n: "replyTo"
      r: false
      t: "`$STRING`"
    }
    status: {
      h: "Status"
      n: "status"
      r: true
      sh: "`reported` when the recipient marked an email the agent sent as spam"
      t: "`$STRING`"
    }
    subject: {
      h: "Subject"
      n: "subject"
      op: {
        create: {
          req: false
          type: "`$STRING`"
        }
      }
      r: true
      t: [
        "`$ONE`"
        [
          "`$STRING`"
          "`$NULL`"
        ]
      ]
    }
    text: {
      h: "Text"
      n: "text"
      r: true
      t: "`$STRING`"
    }
    thread: {
      h: "Thread"
      n: "thread"
      op: {
        create: {
          req: false
          type: "`$STRING`"
        }
      }
      r: true
      sh: "For received and imported email, its Message-ID and References; for email the agent sent, those of the email it answered"
      t: "`$ANY`"
    }
    to: {
      h: "To"
      n: "to"
      op: {
        create: {
          req: false
          type: "`$ARRAY`"
        }
      }
      r: true
      sh: "Whom the message names as its recipients; an inbound one names the agent unless it got a blind copy"
      t: "`$ARRAY`"
    }
  }

