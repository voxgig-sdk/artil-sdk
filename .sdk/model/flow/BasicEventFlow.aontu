# BasicEventFlow

main: kit: flow: BasicEventFlow:
{
  entity: "event",
  kind: "basic",
  name: "BasicEventFlow",
  step: [
    {
      i: {
        ref: "event_ref01"
      }

      m: {
        agent_id: "agent01"
      }

      o: "create"
    }

    {
      m: {
        agent_id: "agent01"
      }

      o: "list",
      v: [
        {
          apply: "ItemExists",
          def: {
            ref: "event_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicEventFlow"
}